{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "noImplicitAny": true,
    "strictNullChecks": true,

    "module": "esnext",
    "target": "ES2017",
    "lib": ["ES2017", "DOM"],

    "jsx": "react-jsx",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "paths": {
      "@appFirebase": ["./src/shared/api/firebase/firebase.ts"],
      "@app/*": ["./src/app/*"],
      "@entities/*": ["./src/entities/*"],
      "@pages/*": ["./src/pages/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@widgets/*": ["./src/widgets/*"]
    }
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
