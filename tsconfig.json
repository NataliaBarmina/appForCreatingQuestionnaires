{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "module": "esnext", //? es6
    "target": "ES2017",
    "lib": ["ES2017", "DOM"],
    "jsx": "react-jsx", // jsx- чтобы не импортировать реакт в компоненты
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@appFirebase": ["./firebase.js"],
      "@app/*": ["./src/app/*"],
      "@entities/*": ["./src/entities/*"],
      "@pages/*": ["./src/pages/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@widgets/*": ["./src/widgets/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "firebase.js", "src/index.js"],
  "exclude": ["node_modules", "dist"]
}
